# The variables for compose.yaml. Copy this file to .env and fill in the first three where empty:
#
#   cp .env.example .env
#
# .env then holds secrets, so .gitignore keeps it out of git; this file holds none. Compose hands
# every variable in .env to the engine, so a channel's { env: NAME } settings go here too. Pathways
# itself never reads a .env file.

# The Pathways release to run: a version tag of ghcr.io/cosyte/pathways, such as 0.1.0, or for
# production the tag and its digest, such as 0.1.0@sha256:<digest>. Compose reads it; the engine
# does not.
PATHWAYS_VERSION=

# The password of the PostgreSQL service's pathways user. Letters and digits only, since it also
# goes into the connection URL: openssl rand -hex 24 makes one.
POSTGRES_PASSWORD=

# The master key that wraps each stored message's data key: 32 random bytes in base64, from
# openssl rand -base64 32. compose.yaml's pathways.yaml names it. Keep a copy in your secret store:
# without it the stored messages cannot be read.
PATHWAYS_KEY=

# The rest are every variable Pathways reads by name. Each is optional here: uncomment one to set it.

# The connection URL of a database server, when pathways.yaml's storage names no url. compose.yaml
# builds it for the PostgreSQL service from POSTGRES_PASSWORD; set it to use another server.
# PATHWAYS_DATABASE_URL=postgres://pathways:change-me@example.com:5432/pathways

# The bearer token of an HTTP source that sets no auth: at least 16 characters of letters, digits
# and -._~+/.
# PATHWAYS_HTTP_TOKEN=

# The bearer token of the health endpoint when its block sets no auth, in the same form.
# PATHWAYS_HEALTH_TOKEN=

# A folder only the engine's user may write in, for the control socket that pathways channel uses.
# Unset, the socket goes in a folder of the user's own under the temporary folder.
# XDG_RUNTIME_DIR=/run/user/65532

# For the crash tests of Pathways itself only: the engine halts at the named fault point. Never set
# it on an engine that moves real messages.
# PATHWAYS_TEST_FAULT_POINT=

# For the crash tests of Pathways itself only: a file whose arrival lets a halted engine carry on.
# PATHWAYS_TEST_FAULT_POINT_RESUME=
