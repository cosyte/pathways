{
  "extends": "@cosyte/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "noEmit": true,
    "paths": {
      "@cosyte/pathways": ["./src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "templates/**/*.ts",
    "examples/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
