{
  "name": "@cosyte/pathways",
  "version": "0.0.3",
  "description": "A code-first healthcare integration engine for Node.js: channels in YAML, transforms in TypeScript.",
  "keywords": [
    "healthcare",
    "integration-engine",
    "interoperability",
    "hl7",
    "hl7v2",
    "mllp",
    "fhir",
    "x12",
    "c-cda",
    "typescript"
  ],
  "homepage": "https://github.com/cosyte/pathways#readme",
  "bugs": {
    "url": "https://github.com/cosyte/pathways/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/pathways.git"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "bin": {
    "pathways": "./dist/bin/pathways.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema/channel.json": "./schema/channel.json",
    "./schema/project.json": "./schema/project.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "scripts": {
    "build": "cosyte-process build",
    "changeset": "changeset",
    "typecheck": "cosyte-process typecheck",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "check:no-emdash": "cosyte-no-emdash",
    "check:no-internal-refs": "cosyte-internal-refs",
    "check:claude-card": "cosyte-claude-card",
    "check:process": "cosyte-process check",
    "lint": "cosyte-process lint",
    "lint:fix": "cosyte-process lint --fix",
    "format": "cosyte-process format",
    "format:check": "cosyte-process format --check",
    "test": "cosyte-process test",
    "test:watch": "cosyte-process test --watch",
    "test:coverage": "cosyte-process test --coverage",
    "clean": "rm -rf dist schema coverage",
    "attw": "cosyte-attw",
    "version": "changeset version && tsx scripts/sync-version.ts && tsx scripts/sync-next-release.ts && tsx scripts/example-pages.ts && cosyte-process format && cosyte-docs-reference",
    "pack:docs": "cosyte-process pack-docs",
    "docs:reference": "cosyte-docs-reference",
    "docs:examples": "tsx scripts/example-pages.ts",
    "check:docs-reference": "cosyte-docs-reference --check",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true",
    "bench": "tsx scripts/bench.ts",
    "bench:reading": "cosyte-bench run --suite bench/pathways.bench.mjs --target dist/index.mjs",
    "bench:compare": "cosyte-bench compare --suite bench/pathways.bench.mjs",
    "bench:profile": "node --expose-gc bench/profile.mjs dist/index.mjs",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@aws-sdk/client-s3": "3.1166.0",
    "@azure/identity": "4.14.1",
    "@azure/storage-blob": "12.34.0",
    "@changesets/cli": "2.31.0",
    "@cosyte/bench": "^0.1.2",
    "@cosyte/eslint-config": "^0.1.4",
    "@cosyte/prettier-config": "^0.1.2",
    "@cosyte/process": "^0.1.8",
    "@cosyte/script-utils": "^0.1.11",
    "@cosyte/synth": "^0.1.10",
    "@cosyte/test-utils": "^0.1.4",
    "@cosyte/transform": "^0.2.4",
    "@cosyte/tsconfig": "^0.1.2",
    "@cosyte/tsup-config": "^0.1.3",
    "@cosyte/vitest-config": "^0.1.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/ssh2": "1.15.6",
    "ajv": "8.17.1",
    "csv-parse": "6.1.0",
    "fast-check": "4.10.2",
    "hdr-histogram-js": "3.0.0",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "simple-git-hooks": "2.14.0",
    "ssh2": "1.17.0",
    "tarn": "3.1.2",
    "tedious": "20.3.8",
    "tsx": "4.23.15",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@cosyte/ccda": "^0.1.6",
    "@cosyte/fhir": "^0.1.9",
    "@cosyte/hl7": "^0.1.14",
    "@cosyte/mllp": "^0.1.12",
    "@cosyte/x12": "^0.1.11",
    "better-sqlite3": "^13.0.3",
    "croner": "^11.0.0",
    "kysely": "^0.29.8",
    "nodemailer": "10.4.0",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "mysql2": "^3.0.0",
    "pg": "^8.0.0",
    "tarn": "^3.0.0",
    "tedious": "^20.0.0",
    "ssh2": "1.17.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "tarn": {
      "optional": true
    },
    "tedious": {
      "optional": true
    },
    "ssh2": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.2": "0.28.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.5",
      "typedoc>minimatch": "10.2.6"
    }
  }
}
