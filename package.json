{
  "name": "@cosyte/pathways",
  "version": "0.0.0",
  "description": "A code-first healthcare integration engine for Node.js: channels in YAML, transforms in TypeScript. Early and not yet released.",
  "keywords": [
    "healthcare",
    "integration-engine",
    "interoperability",
    "hl7",
    "hl7v2",
    "mllp",
    "fhir",
    "x12",
    "c-cda",
    "typescript"
  ],
  "homepage": "https://github.com/cosyte/pathways#readme",
  "bugs": {
    "url": "https://github.com/cosyte/pathways/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/pathways.git"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "bin": {
    "pathways": "./dist/bin/pathways.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "typecheck": "tsc --noEmit",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "check:no-emdash": "node scripts/check-no-emdash.mjs",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" --max-warnings=0 --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write \"**/*.{js,mjs,ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,json,md,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage",
    "attw": "node scripts/attw.mjs",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true",
    "bench": "tsx scripts/bench.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.4",
    "@changesets/cli": "2.31.0",
    "@cosyte/eslint-config": "^0.0.4",
    "@cosyte/prettier-config": "^0.0.2",
    "@cosyte/script-utils": "^0.1.0",
    "@cosyte/synth": "^0.1.0",
    "@cosyte/tsconfig": "^0.0.2",
    "@cosyte/tsup-config": "^0.0.1",
    "@cosyte/vitest-config": "^0.0.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.4",
    "eslint": "10.5.0",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "prettier": "3.8.3",
    "simple-git-hooks": "2.13.0",
    "tarn": "3.1.2",
    "tedious": "20.3.8",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.4"
  },
  "dependencies": {
    "@cosyte/ccda": "^0.1.0",
    "@cosyte/fhir": "^0.1.0",
    "@cosyte/hl7": "^0.1.0",
    "@cosyte/mllp": "^0.1.0",
    "@cosyte/x12": "^0.1.1",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.8",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "mysql2": "^3.0.0",
    "pg": "^8.0.0",
    "tarn": "^3.0.0",
    "tedious": "^20.0.0"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "tarn": {
      "optional": true
    },
    "tedious": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1"
    }
  }
}
