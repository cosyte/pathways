# The environment variables Pathways reads by a fixed name, each with what it is for. Copy this file
# to .env and uncomment what you need. .env then holds secrets, so .gitignore keeps it out of git; this file
# holds none.
#
# Pathways never reads a .env file itself. Load it into the environment that starts the engine:
#
#   set -a && . ./.env && set +a && pathways start
#
# The variables a project's own settings name ({ env: NAME } in pathways.yaml or a channel.yaml,
# such as a master key) go in the same file. examples/docker-compose/ has a .env.example of its own,
# for Docker Compose.

# The connection URL of a database server, when pathways.yaml's storage is postgres, mysql or
# sqlserver and names no url. It holds the password.
# PATHWAYS_DATABASE_URL=postgres://pathways:change-me@example.com:5432/pathways

# The bearer token of an HTTP source that sets no auth: at least 16 characters of letters, digits
# and -._~+/.
# PATHWAYS_HTTP_TOKEN=

# The bearer token of the health endpoint when its block sets no auth, in the same form.
# PATHWAYS_HEALTH_TOKEN=

# A folder only the engine's user may write in, for the control socket that pathways channel uses.
# Unset, the socket goes in a folder of the user's own under the temporary folder.
# XDG_RUNTIME_DIR=/run/user/1000

# For the crash tests of Pathways itself only: the engine halts at the named fault point. Never set
# it on an engine that moves real messages.
# PATHWAYS_TEST_FAULT_POINT=

# For the crash tests of Pathways itself only: a file whose arrival lets a halted engine carry on.
# PATHWAYS_TEST_FAULT_POINT_RESUME=
